{
  "name": "jarukit.com",
  "type": "module",
  "prisma": {
    "schema": "./prisma",
    "seed": "bun prisma/seeds/index.ts"
  },
  "scripts": {
    "prepare": "bun .husky/install.mjs",
    "postinstall": "bun run prisma:generate",
    "______________app_scripts______________": "",
    "dev": "dotenvx run -f .env -- cross-env VITE_CJS_TRACE=true vike dev",
    "build": "dotenvx run -f $(bun run env:file) -- vike build",
    "preview": "dotenvx run -f $(bun run env:file) -- cross-env NODE_ENV=production tsx ./hono-entry.node.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "____________dotenvx_scripts____________": "",
    "env:file": "echo $([ \"$VERCEL_ENV\" = \"production\" ] && echo \".env.production\" || echo \".env\")",
    "env:ec": "dotenvx encrypt -f .env && dotenvx encrypt -f .env.production",
    "env:dc": "dotenvx decrypt -f .env && dotenvx decrypt -f .env.production",
    "____________prisma_scripts____________": "",
    "prisma:studio": "dotenvx run -f .env -- prisma studio",
    "prisma:generate": "dotenvx run -f .env -- prisma generate --no-engine",
    "prisma:validate": "dotenvx run -f .env -- prisma validate",
    "prisma:migrate": "dotenvx run -f .env -- prisma migrate dev --skip-seed",
    "prisma:reset": "dotenvx run -f .env -- prisma migrate reset --force",
    "prisma:seed": "dotenvx run -f .env -- prisma db seed"
  },
  "dependencies": {
    "@auth/core": "^0.39.1",
    "@fontsource/kanit": "^5.2.6",
    "@hono/node-server": "^1.14.4",
    "@mantine/core": "^8.0.2",
    "@mantine/hooks": "^8.0.2",
    "@prisma/extension-accelerate": "^2.0.1",
    "@universal-middleware/core": "^0.4.7",
    "@universal-middleware/hono": "^0.4.12",
    "@vite-plugin-vercel/vike": "^9.0.6",
    "@vitejs/plugin-react": "^4.5.1",
    "hono": "^4.7.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "telefunc": "^0.2.7",
    "vike": "^0.4.231",
    "vike-react": "^0.6.4",
    "vite-plugin-vercel": "^9.0.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.14.1",
    "@dotenvx/dotenvx": "^1.44.2",
    "@eslint-react/eslint-plugin": "^1.51.1",
    "@hono/vite-dev-server": "^0.19.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^18.19.110",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "cross-env": "^7.0.3",
    "eslint": "^9.28.0",
    "eslint-plugin-perfectionist": "^4.14.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.5.4",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "^6.9.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
